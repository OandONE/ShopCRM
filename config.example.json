{
    "app": {
        "title": "ShopCRM"
    },

    "server": {
        "host": "127.0.0.1",
        "port": 8080,
        "reload": false,
        "log_level": "info"
    },

    "database": {
        "path": "database.db",
        "timeout_seconds": 30
    },

    "paths": {
        "templates": "templates",
        "static": "static"
    },

    "session": {
        "cookie_name": "shopcrm_session",
        "days": 7,
        "secure": false,
        "samesite": "lax"
    },

    "login_rate_limit": {
        "max_attempts": 5,
        "window_minutes": 15,
        "cleanup_minutes": 30
    },

    "cors": {
        "allow_origins": []
    }
}